{
  "version": 1,
  "notes": "ROK2 anti-cheat config (P4-T5). Per-player rate limits for write actions, enforced server-side. Window/cooldown in milliseconds, max_actions per window per player. Cooldown = minimum gap between two consecutive actions of the same kind. Anomaly thresholds flag suspicious single-request payloads (reject). All values read by sim/anticheat.ts — no hardcoded limits in code.",
  "constants": {
    "enabled": true,
    "violation_log_limit": 50
  },
  "rate_limits": {
    "march": { "window_ms": 60000, "max_actions": 10, "cooldown_ms": 1000 },
    "pass_attack": { "window_ms": 60000, "max_actions": 5, "cooldown_ms": 2000 },
    "help": { "window_ms": 60000, "max_actions": 15, "cooldown_ms": 500 },
    "shop_buy": { "window_ms": 60000, "max_actions": 20, "cooldown_ms": 0 },
    "use_speedup": { "window_ms": 60000, "max_actions": 30, "cooldown_ms": 0 },
    "rally": { "window_ms": 60000, "max_actions": 3, "cooldown_ms": 5000 },
    "shield_activate": { "window_ms": 60000, "max_actions": 10, "cooldown_ms": 0 },
    "city_relocate": { "window_ms": 60000, "max_actions": 5, "cooldown_ms": 0 }
  },
  "anomaly": {
    "max_troops_per_march": 200000,
    "max_single_unit_per_march": 100000,
    "max_shop_buy_count": 99,
    "min_march_distance_tiles": 1,
    "max_active_marches_per_player": 5
  }
}
