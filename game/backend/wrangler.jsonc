{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rok2-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  // ADMIN_KEY و AUTH_SECRET أُزيلا من هنا عمداً.
  // كانا نصاً صريحاً في المستودع ومنشورين على الخادم الحي:
  //   AUTH_SECRET يوقّع رموز الدخول -> من يملكه ينتحل أي حساب.
  //   ADMIN_KEY يفتح منح الموارد وتقديم زمن الموسم.
  // اضبطهما كأسرار حقيقية (لا تُخزَّن في Git):
  //   wrangler secret put AUTH_SECRET
  //   wrangler secret put ADMIN_KEY
  // وللتطوير المحلي: انسخ .dev.vars.example إلى .dev.vars
  "vars": {
    "KINGDOM_ID": "kingdom-1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rok2-db",
      "database_id": "297c811a-ba1e-4f64-88ca-98513cce3042",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "KINGDOM_SHARD",
        "class_name": "KingdomShard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KingdomShard"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
